{
  "name": "emon-material-admin",
  "version": "3.5.0",
  "description": "Offline-First Customizable Admin Dashboard Theme combining Google Material 3 and Microsoft Metro UI",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/emon-material.min.css --minify",
    "start": "python3 -m http.server 8080",
    "serve": "python3 -m http.server 8080",
    "dev": "python3 -m http.server 8080",
    "test": "node tests/run.mjs",
    "test:pages": "node tests/audit-pages.mjs",
    "test:contrast": "node tests/audit-contrast.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardtorangga911/Emon-Material-Admin.git"
  },
  "keywords": [
    "admin-dashboard",
    "material-3",
    "metro-ui",
    "offline-first",
    "theme",
    "tailwind",
    "dashboard-template",
    "customizable-theme",
    "emon-material-admin"
  ],
  "author": "Edward Torangga",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
